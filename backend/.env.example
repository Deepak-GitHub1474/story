# Copy to .env for local development. Never commit .env.
# Generate real secrets with: make secrets

API_ENV=local
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=9000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3100

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=story_local
REDIS_URL=redis://127.0.0.1:6379/0
ENSURE_INDEXES_ON_BOOT=true
RUN_BACKGROUND_JOBS=true

# REQUIRED. Production refuses to start if these are short, low-entropy,
# reused, or still contain a placeholder marker. Generate with: make secrets
JWT_SECRET=replace-me-run-make-secrets
EMAIL_INDEX_KEY=replace-me-run-make-secrets
EMAIL_ENCRYPTION_KEY=replace-me-run-make-secrets
OTP_HMAC_SECRET=replace-me-run-make-secrets

COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Mail. Gmail SMTP works with a 16-character App Password, not the account
# password. Generate one at myaccount.google.com/apppasswords with 2-Step
# Verification on. console prints codes to the log and is refused in production.
MAIL_PROVIDER=console
MAIL_FROM=Story <no-reply@your-domain>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-gmail-address
SMTP_PASSWORD=replace-with-your-16-char-app-password
SMTP_USE_TLS=true

# Object storage. local writes to disk and needs nothing. Switching to r2 needs
# only these five values, no code change.
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=replace-with-your-r2-access-key-id
STORAGE_S3_SECRET_KEY=replace-with-your-r2-secret-access-key
STORAGE_S3_BUCKET_VAULT=story-vault
STORAGE_S3_BUCKET_MEDIA=story-media

# The AI gate. Get a key at aistudio.google.com/apikey. With AI_PROVIDER=none
# every check is skipped and publishing carries on unmoderated.
AI_PROVIDER=none
AI_API_KEY=replace-with-your-google-ai-studio-key
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_SECONDS=20
