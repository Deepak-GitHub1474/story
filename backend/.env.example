API_ENV=local
APP_VERSION=0.1.0
PORT=9000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=story_local
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
MAIL_PROVIDER=console
EMAIL_INDEX_KEY=local-dev-email-index-key-change-me-000000000000
EMAIL_ENCRYPTION_KEY=local-dev-email-encryption-key-change-me-0000
OTP_HMAC_SECRET=local-dev-otp-secret-change-me-00000000000000
PUBLIC_WEB_URL=https://story.app
