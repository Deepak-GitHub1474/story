# Both are inlined into the browser bundle at build time, so a change here
# needs a rebuild, not just a restart. Never put a secret behind NEXT_PUBLIC_.
#
# The API's CORS_ORIGINS must list NEXT_PUBLIC_SITE_URL or the browser blocks
# every call, and the API's PUBLIC_WEB_URL must match it or shared story links
# point at the wrong host.

# --- Dev ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9000/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Prod ---
# NEXT_PUBLIC_API_BASE_URL=https://your-api-host/v1
# NEXT_PUBLIC_SITE_URL=https://your-web-host
